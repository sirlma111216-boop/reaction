{
  // 리액션 카페 — Cloudflare Workers + Durable Objects (SQLite) + Static Assets
  // 교사 비밀번호는 여기 적지 않는다. `wrangler secret put TEACHER_PASSWORD` 로만 등록한다.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reaction-cafe",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws", "/ws/*"]
  },
  "vars": {
    "TEACHER_ID": "teacher",
    "ENVIRONMENT": "production"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "RoomDurableObject" },
      { "name": "DIRECTORY", "class_name": "DirectoryDurableObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDurableObject", "DirectoryDurableObject"] }
  ]
}
